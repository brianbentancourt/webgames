# Copiar a .env. Nada de esto es obligatorio para desarrollar.

# Sin clave el juego corre entero con los textos de respaldo de cada tablero,
# que es el mismo camino de código que corre cuando la red está mal.
GROQ_API_KEY=

# Solo para docker compose: token del túnel de Cloudflare.
# Ver deploy/cloudflared/README.md
TUNNEL_TOKEN=
